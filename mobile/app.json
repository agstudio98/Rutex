{
  "expo": {
    "name": "Rutex",
    "slug": "rutex-mobile",
    "scheme": "rutex",
    "version": "0.1.0-beta.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rutex necesita acceder a tu ubicación para el mapa de seguridad y acompañamiento en vivo.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Rutex requiere ubicación en segundo plano para proteger tu trayecto."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1A24"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
